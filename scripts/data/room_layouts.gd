## Picks a floor plan at random and may mirror it, so rooms feel different.
static func pick(rng: RandomNumberGenerator, boss: bool) -> Array[String]:
	var source: Dictionary = BOSS if boss else FIGHT
	var keys: Array = source.keys()
	var rows: Array[String] = tidy(source[keys[rng.randi() % keys.size()]])
	if rng.randf() < 0.5:
		rows = mirror_x(rows)
	if rng.randf() < 0.5:
		rows.reverse()
	return rows


## Makes sure a plan is exactly 13 rows of 28 known letters.
static func tidy(raw: Array) -> Array[String]:
	var rows: Array[String] = []
	for y in INNER_ROWS:
		var line: String = raw[y] if y < raw.size() else ""
		var fixed := ""
		for x in INNER_COLS:
			var ch := line[x] if x < line.length() else "."
			fixed += ch if ch in "#~" else "."
		rows.append(fixed)
	# Never block the two doorways or the spot where the chest appears.
	for y in [5, 6, 7]:
		rows[y] = "..." + rows[y].substr(3, INNER_COLS - 6) + "..."
	rows[6] = rows[6].substr(0, 12) + "...." + rows[6].substr(16)
	return rows


static func mirror_x(rows: Array[String]) -> Array[String]:
	var out: Array[String] = []
	for line in rows:
		out.append(line.reverse())
	return out
